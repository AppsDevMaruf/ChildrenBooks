<resources>
    <style name="Theme.ChildrenBooks" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">@font/nunito</item>
        <item name="android:colorAccent">@color/brand_secondary</item>
        <item name="android:statusBarColor">@color/brand_background</item>
        <item name="android:navigationBarColor">@color/white</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.ChildrenBooks.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@android:color/white</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.ChildrenBooks</item>
    </style>
</resources>
