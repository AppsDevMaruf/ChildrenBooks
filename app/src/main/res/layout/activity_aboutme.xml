<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#fff"
    android:orientation="vertical"
    tools:context=".Activites.Aboutme">


    <RelativeLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="#fff"
        android:orientation="vertical"
        tools:context=".Activites.Aboutme">

        <de.hdodenhof.circleimageview.CircleImageView xmlns:app="http://schemas.android.com/apk/res-auto"
            android:id="@+id/profile_image"
            android:layout_width="@dimen/_120sdp"
            android:layout_height="@dimen/_120sdp"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="@dimen/_60sdp"
            android:src="@drawable/maruf"
            app:civ_border_color="#FF000000"
            app:civ_border_width="2dp" />

        <TextView
            android:id="@+id/profileTetile"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/profile_image"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="@dimen/_5sdp"
            android:text="@string/maruf_alam"
            android:textColor="#000"
            android:textSize="@dimen/_18sdp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/profileTetile"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="@dimen/_2sdp"
            android:text="@string/android_developer"
            android:textColor="@color/blackshedo"
            android:textSize="@dimen/_14sdp" />

        <ImageView
            android:id="@id/profileUi"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_72sdp"
            android:layout_below="@id/desc"
            android:layout_marginTop="-20dp"
            android:src="@drawable/ic_waveup" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@+id/profileUi"
            android:layout_marginTop="-10dp"
            android:background="@color/bluelight">

            <LinearLayout
                android:id="@+id/profilelay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginRight="@dimen/_20sdp"
                android:orientation="horizontal">

                <ImageView
                    android:onClick="myProfile"
                    android:layout_width="@dimen/_24sdp"
                    android:layout_height="@dimen/_24sdp"
                    android:layout_marginStart="@dimen/_40sdp"
                    android:background="@drawable/bgicon"
                    android:src="@drawable/ic_profile"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginStart="@dimen/_10sdp"
                    android:background="@drawable/backgroundstyle"
                    android:fontFamily="@font/alef_bold"
                    android:includeFontPadding="false"
                    android:onClick="myProfile"
                    android:padding="@dimen/_2sdp"
                    android:text="My Profile"
                    android:textAlignment="center"
                    android:textColor="@color/black"
                    android:textSize="@dimen/_18sdp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/mgslay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/profilelay"
                android:layout_marginTop="@dimen/_15sdp"
                android:layout_marginRight="@dimen/_20sdp"
                android:orientation="horizontal">

                <ImageView
                    android:onClick="gowhatsapps"
                    android:layout_width="@dimen/_24sdp"
                    android:layout_height="@dimen/_24sdp"
                    android:layout_marginStart="@dimen/_40sdp"
                    android:src="@drawable/ic_mail" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginStart="@dimen/_10sdp"
                    android:background="@drawable/backgroundstyle"
                    android:clickable="true"
                    android:fontFamily="@font/alef"
                    android:includeFontPadding="false"
                    android:onClick="gowhatsapps"
                    android:text="Message"
                    android:textAlignment="center"
                    android:textColor="@color/black"
                    android:textSize="@dimen/_18sdp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/emailLay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/mgslay"
                android:layout_marginTop="@dimen/_15sdp"
                android:layout_marginRight="@dimen/_20sdp"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="@dimen/_24sdp"
                    android:layout_height="@dimen/_24sdp"
                    android:layout_marginStart="@dimen/_40sdp"
                    android:onClick="sendMail"
                    android:src="@drawable/ic_gmail" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginStart="@dimen/_10sdp"
                    android:background="@drawable/backgroundstyle"
                    android:clickable="true"
                    android:fontFamily="@font/alef"
                    android:onClick="sendMail"
                    android:text="marufalam120@gmail.com"
                    android:textAlignment="center"
                    android:textColor="@color/black"
                    android:textSize="@dimen/_16sdp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/websitelay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/fblay"
                android:layout_marginTop="@dimen/_15sdp"
                android:layout_marginRight="@dimen/_20sdp"
                android:orientation="horizontal">

                <ImageView
                    android:onClick="gotoWebsite"
                    android:layout_width="@dimen/_24sdp"
                    android:layout_height="@dimen/_24sdp"
                    android:layout_marginLeft="@dimen/_40sdp"
                    android:background="@drawable/bgicon"
                    android:src="@drawable/ic_web_search_engine" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginLeft="@dimen/_10sdp"
                    android:background="@drawable/backgroundstyle"
                    android:fontFamily="@font/alef"
                    android:onClick="gotoWebsite"
                    android:paddingStart="@dimen/_5sdp"
                    android:paddingRight="@dimen/_5sdp"
                    android:text="@string/www_marufalam_com"
                    android:textAlignment="center"
                    android:textColor="@color/black"
                    android:textSize="@dimen/_18sdp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/fblay"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/emailLay"
                android:layout_marginTop="@dimen/_15sdp"
                android:layout_marginRight="@dimen/_20sdp"
                android:orientation="horizontal">

                <ImageView
                    android:onClick="goFacebook"
                    android:layout_width="@dimen/_24sdp"
                    android:layout_height="@dimen/_24sdp"
                    android:layout_marginLeft="@dimen/_40sdp"
                    android:src="@drawable/ic_facebook" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginStart="@dimen/_10sdp"
                    android:background="@drawable/backgroundstyle"
                    android:fontFamily="@font/alef"
                    android:includeFontPadding="false"
                    android:onClick="goFacebook"
                    android:text="Maruf Alam Porosh"
                    android:textAlignment="center"
                    android:textColor="@color/black"
                    android:textSize="@dimen/_18sdp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/websitelay"
                android:layout_marginTop="@dimen/_15sdp"
                android:layout_marginRight="@dimen/_20sdp"
                android:orientation="horizontal">

                <ImageView
                    android:onClick="goMap"
                    android:background="@drawable/bgicon"
                    android:layout_width="@dimen/_24sdp"
                    android:layout_height="@dimen/_24sdp"
                    android:layout_marginStart="@dimen/_40sdp"
                    android:src="@drawable/ic_google_maps" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginStart="@dimen/_10sdp"
                    android:background="@drawable/backgroundstyle"
                    android:fontFamily="@font/alef"
                    android:onClick="goMap"
                    android:paddingStart="@dimen/_5sdp"
                    android:paddingRight="@dimen/_5sdp"
                    android:text="@string/location"
                    android:textAlignment="center"
                    android:textColor="@color/black"
                    android:textSize="@dimen/_18sdp" />

            </LinearLayout>


        </RelativeLayout>
    </RelativeLayout>
</RelativeLayout>