<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
xmlns:tools="http://schemas.android.com/tools"
android:layout_width="match_parent"
android:layout_height="match_parent"
android:padding="5dp" android:layout_margin="@dimen/_13sdp"
android:background="#FFFFFF"
tools:context=".Fragments.AlphabetBaseFragment">
<RelativeLayout

    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:id="@+id/mainRL"
        android:weightSum="4"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <ImageView
                    android:id="@+id/image_one"
                    android:layout_width="@dimen/_110sdp"
                    android:layout_height="@dimen/_110sdp"
                    android:src="@drawable/a" />

                <ImageView
                    android:id="@+id/smallLetterId"
                    android:layout_width="@dimen/_64sdp"
                    android:layout_height="@dimen/_64sdp"
                    android:layout_alignParentBottom="true"
                    android:layout_marginStart="-2dp"
                    android:layout_marginLeft="-2dp"
                    android:layout_marginBottom="20dp"
                    android:layout_toEndOf="@+id/image_one"
                    android:layout_toRightOf="@+id/image_one"
                    android:src="@drawable/small_a" />

                <TextView
                    android:id="@+id/word_one"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_40sdp"
                    android:layout_marginEnd="@dimen/_10sdp"
                    android:layout_marginRight="@dimen/_10sdp"
                    android:layout_toEndOf="@+id/smallLetterId"
                    android:layout_toRightOf="@+id/smallLetterId"
                    android:gravity="center_horizontal"
                    android:includeFontPadding="false"
                    android:text="@string/children"
                    android:textAlignment="textEnd"
                    android:textColor="#c52828"
                    android:textSize="@dimen/_22ssp"
                    android:textStyle="bold"
                    tools:ignore="RtlCompat" />

                <TextView

                    android:id="@+id/word_two"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/word_one"
                    android:layout_marginTop="@dimen/_7sdp"
                    android:layout_marginEnd="@dimen/_10sdp"
                    android:layout_marginRight="@dimen/_10sdp"
                    android:layout_toEndOf="@+id/smallLetterId"
                    android:layout_toRightOf="@+id/smallLetterId"
                    android:gravity="center_horizontal"
                    android:includeFontPadding="false"
                    android:text="@string/books"
                    android:textAlignment="textEnd"
                    android:textColor="#c52828"
                    android:textSize="@dimen/_22ssp"
                    android:textStyle="bold"
                    tools:ignore="RtlCompat" />
            </RelativeLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="2.5"
            android:orientation="horizontal">
            <ImageView
                android:id="@+id/image_two"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/apple"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight=".5"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/details"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:gravity="center"
                android:includeFontPadding="false"
                android:paddingLeft="@dimen/_15sdp"
                android:paddingRight="@dimen/_15sdp"
                android:text="@string/OoText"
                android:textAlignment="center"
                android:textAllCaps="true"
                android:textColor="#c52828"
                android:textColorHighlight="@color/black"
                android:textSize="@dimen/_30ssp"
                android:textStyle="bold" />
        </LinearLayout>


    </LinearLayout>
    <com.google.android.gms.ads.AdView xmlns:ads="http://schemas.android.com/apk/res-auto"
        android:id="@+id/adView"
        android:layout_below="@+id/mainRL"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        ads:adSize="BANNER"
        ads:adUnitId="ca-app-pub-3940256099942544/6300978111"
        tools:ignore="NotSibling,UnknownId">
    </com.google.android.gms.ads.AdView>

</RelativeLayout>



</FrameLayout>